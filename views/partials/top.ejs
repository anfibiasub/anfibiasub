<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Anfibiasub</title>
<meta name="theme-color" content="#050E1A">
<link rel="icon" href="/favicon.png?v=3" type="image/png">
<link rel="stylesheet" href="/css/style.css?v=<%= ASSET_V %>">
<link rel="stylesheet" href="/css/app.css?v=<%= ASSET_V %>">
</head>
<body>
<% if (user) { const admin = user.role === 'admin'; %>
<header class="app-header">
<div class="wrap nav-row">
<a class="logo" href="<%= admin ? '/admin' : '/area/home' %>" aria-label="Anfibiasub">
<img class="logo-img" src="/img/logo-libero.png" alt="" width="52" height="52" style="width:52px;height:52px">
<span class="logo-name">ANFIBIA<span class="hl">SUB</span></span><span class="app-tag"><%= admin ? 'GESTIONE' : L.area.toUpperCase() %></span>
</a>
<button class="btn app-menu-btn" type="button" aria-expanded="false" aria-controls="app-nav" data-app-menu><span class="am-ico" aria-hidden="true"><i></i><i></i><i></i></span><span>Menu</span></button>
<nav class="app-nav" id="app-nav" aria-label="<%= L.area %>">
<% if (admin) { %>
<a href="/admin"<%- path === '/admin' || path.startsWith('/admin/barca') ? ' aria-current="page"' : '' %>>Clienti e barche</a>
<a href="/admin/clienti/nuovo"<%- path === '/admin/clienti/nuovo' ? ' aria-current="page"' : '' %>>Nuovo cliente</a>
<a href="/admin/abyss"<%- path === '/admin/abyss' ? ' aria-current="page"' : '' %>>Statistiche ABYSS</a>
<a href="/admin/impostazioni"<%- path === '/admin/impostazioni' ? ' aria-current="page"' : '' %>>Impostazioni</a>
<a href="/admin/guida"<%- path === '/admin/guida' ? ' aria-current="page"' : '' %>>Guida</a>
<% } else { %>
<a href="/area/home"<%- path === '/area/home' ? ' aria-current="page"' : '' %>><%= L.home %></a>
<a href="/area/scheda"<%- path === '/area/scheda' ? ' aria-current="page"' : '' %>><%= L.boat_sheet %></a>
<a href="/area/manutenzione"<%- path === '/area/manutenzione' ? ' aria-current="page"' : '' %>><%= L.maintenance %></a>
<a href="/area/guida"<%- path === '/area/guida' ? ' aria-current="page"' : '' %>>Guida</a>
<% } %>
<a href="/area/profilo"<%- path === '/area/profilo' ? ' aria-current="page"' : '' %>><%= user.name ? user.name.split(' ')[0] : L.profile %></a>
<form method="post" action="/area/logout"><button class="linkbtn" type="submit"><%= L.logout %></button></form>
</nav>
</div>
</header>
<% } %>
