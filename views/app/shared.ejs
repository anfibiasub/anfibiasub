<%- include('../partials/top', { title: L.shared_title }) %>
<main class="app-main" id="main">
<a class="logo" href="/" aria-label="<%= L.site %>" style="margin-bottom:30px;display:inline-flex"><img src="/img/logo-libero.png" alt="" width="72" height="72"><span class="logo-name" style="color:#fff">ANFIBIA<span class="hl">SUB</span></span></a>
<p class="eyebrow"><%= L.shared_title %> · <%= fmtDate(c.data) %></p>
<h1 class="h2" style="font-size:36px"><%= c.nome %></h1>
<p class="sub" style="margin-bottom:24px"><%= c.tipo %><%= c.note ? ' · ' + c.note : '' %></p>
<%- include('../partials/primadopo', { prima: c.prima, dopo: c.dopo, base: '/area/condividi/' + c.share_token + '/foto/', admin: false, before: L.before, after: L.after, showAll: L.show_all_photos, photoN: L.photo_n }) %>
<p class="hint" style="margin-top:30px"><%= L.shared_by %> · <a href="/">anfibiasub.it</a></p>
</main>
<%- include('../partials/bottom') %>
